{
  "openapi": "3.1.0",
  "info": {
    "title": "GymFlow API",
    "description": "API REST para administrar clientes, membresías, inventario, ventas y caja de un gimnasio, con inicio de sesión por correo y por reconocimiento facial.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Autenticación",
      "description": "Registro e inicio de sesión con correo y contraseña. Públicos."
    },
    {
      "name": "Login facial",
      "description": "Desafío de un solo uso e inicio de sesión con el rostro (pantalla de la caja). Públicos."
    },
    {
      "name": "Clientes y perfil",
      "description": "Perfil propio y CRUD de clientes con baneo. Solo ADMIN, salvo /users/me."
    },
    {
      "name": "Rostro de clientes",
      "description": "Registro, consulta y eliminación del rostro de un cliente. Solo ADMIN."
    },
    {
      "name": "Planes",
      "description": "Planes de membresía. La consulta es pública; el resto, solo ADMIN."
    },
    {
      "name": "Membresías",
      "description": "Alta, edición y renovación (ADMIN) y consulta de la membresía propia (USER)."
    },
    {
      "name": "Pagos",
      "description": "Historial de pagos del cliente. Los cobros en efectivo se registran al asignar o renovar una membresía."
    },
    {
      "name": "Productos",
      "description": "Inventario. Solo ADMIN."
    },
    {
      "name": "Ventas",
      "description": "Registro de ventas con descuento automático de stock. Solo ADMIN."
    },
    {
      "name": "Caja",
      "description": "Salidas de dinero y corte diario. Solo ADMIN."
    }
  ],
