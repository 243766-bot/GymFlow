                  "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Identifica al cliente correcto\", () => {",
                  "  pm.expect(r.usuario.id).to.eql(Number(pm.collectionVariables.get(\"userId\")));",
                  "  pm.expect(r.usuario.rol).to.eql(\"ROLE_USER\");",
                  "});",
                  "pm.test(\"El JWT facial es de corta duración (15 min o menos)\", () => {",
                  "  const payload = r.token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
                  "  const datos = JSON.parse(atob(payload));",
                  "  pm.expect(datos.exp - datos.iat).to.be.at.most(900);",
                  "});"
                ]
              }
            }
