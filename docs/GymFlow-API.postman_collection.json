            "description": "Nombre vacío, correo sin formato y contraseña corta. Las validaciones de Jakarta deben responder 400.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"email\": \"correo-malo\",\n  \"password\": \"123\",\n  \"telefono\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "04 Login correcto (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devuelve un token JWT (3 partes)\", () => pm.expect(r.token.split(\".\")).to.have.lengthOf(3));",
                  "pm.test(\"El usuario es el esperado\", () => pm.expect(r.usuario.email).to.eql(pm.collectionVariables.get(\"nuevoEmail\")));",
                  "pm.test(\"No se expone la contraseña\", () => pm.expect(r.usuario).to.not.have.property(\"password\"));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"userToken\", r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
