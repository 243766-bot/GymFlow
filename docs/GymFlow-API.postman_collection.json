{
  "info": {
    "name": "GymFlow API",
    "description": "Pruebas de autenticación, seguridad y login facial de GymFlow. Requiere el backend corriendo en localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const gen = () => Array.from({ length: 128 }, () => Math.round((Math.random() * 2 - 1) * 10000) / 10000);",
          "if (!pm.collectionVariables.get(\"descriptor\")) pm.collectionVariables.set(\"descriptor\", JSON.stringify(gen()));",
          "if (!pm.collectionVariables.get(\"nuevoEmail\")) pm.collectionVariables.set(\"nuevoEmail\", \"cliente\" + Date.now() + \"@test.com\");"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "nuevoEmail",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "descriptor",
      "value": ""
    },
    {
      "key": "descriptor2",
      "value": ""
    },
    {
      "key": "challenge",
      "value": ""
    },
    {
      "key": "challenge2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Autenticación",
      "item": [
        {
          "name": "01 Registro exitoso (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const gen = () => Array.from({ length: 128 }, () => Math.round((Math.random() * 2 - 1) * 10000) / 10000);",
                  "pm.collectionVariables.set(\"nuevoEmail\", \"cliente\" + Date.now() + \"@test.com\");",
                  "pm.collectionVariables.set(\"descriptor\", JSON.stringify(gen()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devuelve token y tipo Bearer\", () => {",
                  "  pm.expect(r.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(r.tipo).to.eql(\"Bearer\");",
                  "});",
                  "pm.test(\"Todo registro público es ROLE_USER\", () => pm.expect(r.usuario.rol).to.eql(\"ROLE_USER\"));",
                  "pm.test(\"La respuesta NO incluye la contraseña\", () => {",
                  "  pm.expect(r.usuario).to.not.have.property(\"password\");",
                  "  pm.expect(pm.response.text()).to.not.include(\"Prueba1234\");",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"userToken\", r.token);",
                  "  pm.collectionVariables.set(\"userId\", r.usuario.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crea un cliente nuevo con un correo distinto en cada corrida. Todo registro público debe quedar como ROLE_USER.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente de Prueba\",\n  \"email\": \"{{nuevoEmail}}\",\n  \"password\": \"Prueba1234\",\n  \"telefono\": \"9611234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 Registro con correo repetido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"El mensaje indica que el correo ya está registrado\", () => {",
                  "  pm.expect(pm.response.json().message).to.include(\"registrado\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Repite el correo del paso 01. Debe rechazarse.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente de Prueba\",\n  \"email\": \"{{nuevoEmail}}\",\n  \"password\": \"Prueba1234\",\n  \"telefono\": \"9611234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "03 Registro con datos inválidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "const msg = pm.response.json().message;",
                  "pm.test(\"El mensaje menciona los campos inválidos\", () => {",
                  "  pm.expect(msg).to.include(\"email\");",
                  "  pm.expect(msg).to.include(\"password\");",
                  "  pm.expect(msg).to.include(\"nombre\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
